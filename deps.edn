{:paths ["src" "resources"]
 :deps {cheshire/cheshire {:mvn/version "6.2.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.11"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.24"}}
          :ns-default hive-build.api}}}
