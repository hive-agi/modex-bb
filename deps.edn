{:paths ["src" "resources"]
 :deps {cheshire/cheshire {:mvn/version "6.2.0"}}
 :aliases
 {;; "schemas" carries the malli value objects. It is NEVER on :paths: every
  ;; consumer runs modex-bb under Babashka and need not load malli.
  :test {:extra-paths ["test" "schemas"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.11"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.40"}
                      metosin/malli {:mvn/version "0.20.2"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
          :ns-default hive-build.api}}}
